{
  "name": "deepseek-v4-pro-skill-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync-skills": "python3 scripts/sync_skills.py",
    "typecheck": "tsc --noEmit",
    "check:python": "PYTHONPYCACHEPREFIX=/tmp/deepseek-skill-client-pycache python3 -m py_compile deepseek_skill_client.py web_server.py test_deepseek_skill_client.py scripts/sync_skills.py",
    "test:python": "python3 -m unittest -v test_deepseek_skill_client.py",
    "test:web-js": "node --check web/app.js",
    "test": "npm run sync-skills && npm run typecheck && npm run lint && npm run check:python && npm run test:python && npm run test:web-js",
    "predev": "npm run sync-skills",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run sync-skills",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
