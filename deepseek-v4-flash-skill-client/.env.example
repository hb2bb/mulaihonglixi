# 从 DeepSeek 开放平台获取，不要把真实 Key 提交到代码仓库。
DEEPSEEK_API_KEY=替换为你的_API_Key

# 以下两项已有正确默认值，一般无需设置。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：记忆整理默认复用上面的 DeepSeek V4 模型。
# DEEPSEEK_MEMORY_MODEL=deepseek-v4-pro

# 实时状态使用独立的 OpenAI 兼容 API，不复用聊天模型配置。
STATE_API_KEY=替换为状态模型的_API_Key
STATE_BASE_URL=https://替换为状态模型的接口地址
STATE_MODEL=替换为状态模型名称

# 回复发送前审查使用第三套独立的 OpenAI 兼容 API。
REVIEW_API_KEY=替换为审查模型的_API_Key
REVIEW_BASE_URL=https://替换为审查模型的接口地址
REVIEW_MODEL=替换为审查模型名称

# 可选：实时状态默认使用北京和 Asia/Shanghai，每 30 分钟由网页刷新。
# LIVE_STATE_CITY=北京
# LIVE_STATE_LATITUDE=39.9042
# LIVE_STATE_LONGITUDE=116.4074
# LIVE_STATE_TIMEZONE=Asia/Shanghai

# 网站后端也使用上面的同一个 Key。不要用 NEXT_PUBLIC_ 前缀，否则会暴露给浏览器。

# 强烈建议公开给别人体验时设置。访客需要输入此访问码才能调用付费模型。
# SITE_ACCESS_KEY=请换成一个足够长且难猜的访问码

# 可选：额外的 Skill 根目录。macOS/Linux 用冒号分隔，Windows 用分号分隔。
# EXTRA_SKILL_ROOTS=/path/to/skills:/another/path/to/skills
